# =====================================================================
# Copy to .env and fill in. Never commit .env.
# Nothing is assumed: URLs, credentials, endpoints and devices are yours to provide.
# =====================================================================

# ---------- General ----------
# TEST_ENV selects the environment for EVERYTHING (web, mobile, API, test data folder, evidence banner).
# Any variable below can be overridden per environment with a suffix, e.g. BASE_URL_STAGING, API_TOKEN_QA.
TEST_ENV=local
DEFAULT_TIMEOUT_MS=60000          # Cucumber step timeout (web/mobile)
LOG_LEVEL=info                    # debug | info | warn | error
TC_ID_PREFIXES=TC                 # tags like @TC-WEB-012 count as test case IDs (comma list, e.g. TC,WEB,API); @id=<ID> always works

# ---------- Evidence masking (screenshots) ----------
# Always masked: password fields, card number/CVC, one-time codes, [data-sensitive], [data-mask]; Android password / iOS secure fields
MASK_SELECTORS=                   # extra web CSS selectors, comma-separated
MOBILE_MASK_SELECTORS=            # extra mobile selectors, separated by ||

# ---------- Web (Playwright) ----------
BASE_URL=                         # REQUIRED for web tests — application URL; page.goto('/path') resolves against it
WEB_TIMEOUT_MS=10000              # default wait for actions/element conditions
WEB_NAVIGATION_TIMEOUT_MS=30000   # default wait for page navigation
BROWSER=chromium                  # chromium | firefox | webkit
HEADLESS=true                     # true | false
SLOW_MO_MS=0
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768
IGNORE_HTTPS_ERRORS=false
RECORD_VIDEO=false                # true -> reports/videos
TRACE=false                       # true -> reports/traces (open with: npx playwright show-trace <zip>)

# ---------- Mobile (Appium) ----------
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_BASE_PATH=/
PLATFORM=android                  # android | ios
APPIUM_SESSION_TIMEOUT_MS=600000  # session start timeout (first iOS run builds WebDriverAgent)
MOBILE_TIMEOUT_MS=15000           # default explicit wait for element conditions
NO_RESET=false
FULL_RESET=false

# Android — emulator: DEVICE_NAME (+ AVD to auto-boot) | real device: UDID from `adb devices`
ANDROID_DEVICE_NAME=
ANDROID_PLATFORM_VERSION=
ANDROID_AVD=
ANDROID_UDID=
ANDROID_APP_PATH=                 # absolute path to .apk  — OR —  package + activity below
ANDROID_APP_PACKAGE=
ANDROID_APP_ACTIVITY=

# iOS — simulator: DEVICE_NAME + VERSION | real device: UDID + XCODE_ORG_ID (signing)
IOS_DEVICE_NAME=
IOS_PLATFORM_VERSION=
IOS_UDID=
IOS_APP_PATH=                     # .app (simulator) / .ipa (real device)  — OR —  bundle id
IOS_BUNDLE_ID=
IOS_XCODE_ORG_ID=
IOS_XCODE_SIGNING_ID=iPhone Developer
IOS_WDA_LAUNCH_TIMEOUT_MS=300000
IOS_AUTO_ACCEPT_ALERTS=false      # true = auto-accept iOS permission alerts; otherwise handle them in a screen object

# ---------- API (Karate) ----------
API_BASE_URL=                     # REQUIRED for API tests
API_MAX_RESPONSE_MS=3000          # response time threshold (assert responseTime < maxResponseTime)

API_TIMEOUT_MS=30000
API_THREADS=1                     # parallel Karate threads
API_SSL_TRUST_ALL=false

API_AUTH_TYPE=none                # none | bearer | basic | apikey | oauth2
API_TOKEN=                        # bearer
API_USERNAME=                     # basic
API_PASSWORD=                     # basic
API_KEY=                          # apikey
API_KEY_HEADER=x-api-key          # apikey header name
API_OAUTH_TOKEN_URL=              # oauth2 client-credentials
API_OAUTH_CLIENT_ID=
API_OAUTH_CLIENT_SECRET=
API_OAUTH_SCOPE=
