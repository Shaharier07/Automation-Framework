{
  "name": "automation",
  "version": "1.0.0",
  "description": "SQA automation framework: TypeScript + Playwright (web) + Appium (mobile) + Karate (API) + Cucumber BDD + Allure",
  "scripts": {
    "setup": "npm install && npm run setup:browsers && npm run setup:appium-drivers && npm run setup:api",
    "setup:browsers": "playwright install chromium firefox webkit",
    "setup:appium-drivers": "appium driver install uiautomator2 || true && appium driver install xcuitest || true",
    "setup:api": "mvn -q -B --no-transfer-progress -f api/pom.xml test-compile",
    "verify": "tsx scripts/verify.ts",
    "typecheck": "tsc -p .",
    "appium": "appium --address 127.0.0.1 --port 4723",
    "test:web": "tsx scripts/run.ts web",
    "test:web:headed": "cross-env HEADLESS=false tsx scripts/run.ts web",
    "test:web:chromium": "cross-env BROWSER=chromium tsx scripts/run.ts web",
    "test:web:firefox": "cross-env BROWSER=firefox tsx scripts/run.ts web",
    "test:web:webkit": "cross-env BROWSER=webkit tsx scripts/run.ts web",
    "test:mobile": "tsx scripts/run.ts mobile",
    "test:android": "cross-env PLATFORM=android tsx scripts/run.ts mobile",
    "test:ios": "cross-env PLATFORM=ios tsx scripts/run.ts mobile",
    "test:api": "tsx scripts/run.ts api",
    "test:regression": "tsx scripts/run.ts regression",
    "report:web": "tsx scripts/allure.ts generate web",
    "report:mobile": "tsx scripts/allure.ts generate mobile",
    "report:api": "tsx scripts/allure.ts generate api",
    "report:all": "tsx scripts/allure.ts generate all",
    "report:open": "tsx scripts/allure.ts open",
    "excel:update": "tsx scripts/update-excel.ts --type all",
    "excel:update:web": "tsx scripts/update-excel.ts --type web",
    "excel:update:mobile": "tsx scripts/update-excel.ts --type mobile",
    "excel:update:api": "tsx scripts/update-excel.ts --type api",
    "excel:update:latest": "tsx scripts/update-excel.ts --type latest",
    "emulator:android": "emulator -avd Automation_Pixel_API35 -no-snapshot-save",
    "devices": "adb devices -l",
    "testcases:extract": "tsx scripts/extract-test-cases.ts",
    "testcases:review": "tsx scripts/test-case-review.ts --input",
    "lint": "eslint .",
    "check:tags": "tsx scripts/check-tags.ts",
    "check:gate": "npm run typecheck && npm run lint && npm run check:tags && cucumber-js --profile web --dry-run && cucumber-js --profile mobile --dry-run && mvn -q -B --no-transfer-progress -f api/pom.xml test-compile",
    "results:failures": "tsx scripts/list-failures.ts",
    "verification:save": "tsx scripts/save-verification.ts --input",
    "test:rerun:web": "tsx scripts/run.ts web --rerun",
    "test:rerun:mobile": "tsx scripts/run.ts mobile --rerun",
    "test:rerun:api": "tsx scripts/run.ts api --rerun",
    "traceability": "tsx scripts/traceability.ts",
    "summary": "tsx scripts/execution-summary.ts"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.14.0",
    "allure-js-commons": "^3.14.0",
    "appium": "^3.9.0",
    "appium-uiautomator2-driver": "^8.7.3",
    "appium-xcuitest-driver": "^12.22.8",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.14.0",
    "exceljs": "^4.4.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "webdriverio": "^10.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
